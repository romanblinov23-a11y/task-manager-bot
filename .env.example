# Часовой пояс для "сегодня", расписания и таймстемпов в таблицах —
# не зависит от часового пояса хоста (важно для Railway, который обычно в UTC)
TIMEZONE=Europe/Moscow

# Telegram
TELEGRAM_BOT_TOKEN=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Путь к SQLite-базе трекера задач (задачи/лог/комментарии). Отдельная база
# от мониторинга конкурентов — общие только пользователи (по telegram_user_id)
TASKS_DB_PATH=data/tasks.db

# Telegram ID Романа — куда слать карточки на подтверждение и отчёты
ROMAN_TELEGRAM_ID=

# Привязка group chat_id -> проект, JSON-объект, например {"-1001234567890": "Окко"}
CHAT_PROJECT_MAP={}

# Время отправки отчётов
DAILY_REPORT_TIME=20:00
WEEKLY_REPORT_DAY=fri
WEEKLY_REPORT_TIME=22:00

# Когда раз в день проверять задачи с подошедшим/просроченным дедлайном
STATUS_CHECK_TIME=10:00
# После скольких неясных ответов подряд эскалировать Роману
MAX_CLARIFYING_ROUNDS=2
# Сколько дней без обновления статуса считается "застрявшей" задачей
STALE_DAYS=5

MESSAGE_BUFFER_HOURS=3
EXTRACTION_CONTEXT_HOURS=2

# Модуль мониторинга конкурентов
# Telegram ID владельцев (через запятую) — видят все рынки, добавляют проекты.
# Если не задано, по умолчанию — только ROMAN_TELEGRAM_ID.
OWNER_TELEGRAM_IDS=
# Путь к SQLite-базе рынков/конкурентов/снятий
MONITORING_DB_PATH=data/monitoring.db
# Время ежедневной проверки расписания мониторинга и отправки напоминаний
MONITORING_REMINDER_TIME=09:30

# Ежедневный отчёт по смене
# Когда просить у управляющего график смен (14-е и последний день месяца)
SHIFT_SCHEDULE_REMINDER_TIME=10:00
# Когда начинать собирать вечерний отчёт у ответственного менеджера
SHIFT_REPORT_START_TIME=22:00
# Если к этому времени отчёт не собран — эскалация управляющему
SHIFT_REPORT_ESCALATE_TIME=23:30
# Если к этому времени вчерашний отчёт всё ещё не согласован Романом — сообщить ему напрямую
SHIFT_REPORT_OWNER_ESCALATE_TIME=09:00
# Когда рассылать вчерашние согласованные отчёты в чат финпартнёров
SHIFT_REPORT_DISPATCH_TIME=10:00
# Когда просить у управляющего план по выручке/чекам на следующий месяц (25-е число)
MONTHLY_PLAN_REMINDER_TIME=10:00
# Утреннее напоминание команде точки — план на день + старт/стоп-листы со вчера
TEAM_MORNING_REPORT_TIME=07:00
# Собрания: во сколько ежедневно проверять ритм и просить подтверждения на завтра
MEETING_CONFIRM_TIME=10:00
